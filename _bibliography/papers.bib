  author      = {Wu, Ruihan and Li, Chunying and Lei, Qirong and Huang, Le and Li, Pengcheng and Guo, Shuxiang},
  booktitle   = {2026 IEEE International Conference on Mechatronics and Automation (ICMA)},
  year        = {2026},
  abbr        = {ICMA},
  selected    = {true},
  preview     = {teacher_student_simulators.png},
  pdf         = {632011_RuihanWu_paper.pdf},
  code        = {https://github.com/RayH-Wu/DeepHydroSim-AUV_RL_Control},
  abstract    = {Deep Hydro-Sim bridges a high-fidelity underwater simulator and a fast rigid-body engine by learning residual hydrodynamic forces from Stonefish and injecting them into MuJoCo as a real-time plugin. The result improves open-loop replay fidelity and stabilizes downstream SAC training for AUV control without sacrificing throughput.},
  bibtex_show = {true},
}
