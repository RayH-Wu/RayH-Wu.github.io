@unpublished{wu2026turning,
  title       = {Turning Safety into Competency: Equilibrium-Preserving Play in Multi-Robot Interaction},
  author      = {Wu, Ruihan},
  year        = {2026},
  abbr        = {Preprint},
  selected    = {true},
  preview     = {safety-game.gif},
  abstract    = {A safety rule is usually paid for with a reward penalty, traded off against the task. We encode it instead as a least-restrictive filter, so it reshapes the space of admissible strategies rather than the score. Under such a filter the rule is never realised in play and the competitive equilibrium is preserved exactly, which we verify on two quadrupeds in a zero-sum interaction.},
