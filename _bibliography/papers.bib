@article{wu2026competence,
  title       = {Turning Safety into Competence: Minimally Exploitable Robot Policies via Safety-Filtered Reinforcement Learning},
  author      = {Wu*, Ruihan and Yang*, Rui and Oh, Donggeon David and Nguyen, Duy and Hu, Haimin},
  journal     = {arXiv preprint arXiv:2609.27312},
  year        = {2026},
  abbr        = {arXiv},
  selected    = {true},
  arxiv       = {2609.27312},
  preview     = {s2c_preview.mp4},
  html        = {https://ar5iv.labs.arxiv.org/html/2609.27312},
  pdf         = {https://arxiv.org/pdf/2609.27312},
  website     = {https://alliance-ai.cs.jhu.edu/s2c/},
  video       = {/assets/video/s2c_demo.mp4},
  abstract    = {Robots deployed for competitive tasks must outmaneuver their opponents without sacrificing safety. Existing approaches, including safe reinforcement learning, train a single policy to achieve task success and avoid failures simultaneously, which can leave the learned policy exploitable by deliberate attacks. We propose Safety to Competence (S2C), a two-stage reinforcement learning framework that separates safety synthesis from competitive task learning. S2C learns a robust safety filter via adversarial reinforcement learning, embeds it during task policy training, and retains the same filter at deployment. In simulated touchdown games, S2C achieves the highest win rate and Elo rating and the lowest exploitability among safe reinforcement learning baselines; hardware stress tests against a human opponent further confirm its competence.},
  bibtex_show = {true},
}

